{
  "name": "hyrelog-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "npx prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --tsconfig tsconfig.json tests/dashboard-drilldown.test.ts tests/dashboard-insights.test.ts tests/dashboard-histogram-merge.test.ts tests/dashboard-metrics.test.ts tests/dashboard-event-volume-histogram.test.ts tests/dashboard-native-histogram-env.test.ts tests/dashboard-home-insights-policy.test.ts tests/events-explorer-url.test.ts tests/events-explorer-row-format.test.ts tests/events-explorer-malformed-query.test.ts tests/explorer-export-request.test.ts tests/event-query-url.test.ts tests/filtered-export-compat.test.ts tests/exports-ui.test.ts tests/export-template-schema.test.ts tests/export-download-error-sanitize.test.ts tests/audit-export-actions.test.ts",
    "email:dev": "email dev",
    "db:reset": "npx prisma generate && npx tsx prisma/seed/resetToDefault.ts",
    "db:seed": "npx prisma generate && npx tsx prisma/seed/seedAll.ts",
    "db:seed:screenshot": "npx prisma generate && npx tsx prisma/seed/seedScreenshotDemo.ts",
    "db:migrate:deploy": "npx prisma migrate deploy"
  },
